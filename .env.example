# Mode pengukuran:
# file = baca hasil asli dari alat
# mock = pakai data contoh
MEASUREMENT_MODE=file

# Lokasi folder program-python.
# Biarkan kosong jika folder program-python berada sejajar dengan folder website.
PROGRAM_PYTHON_BASE=

# Lokasi file hasil pengukuran.
# Biarkan kosong agar sistem otomatis mencari dari PROGRAM_PYTHON_BASE.
MEASUREMENT_SOURCE_PATH=

# Untuk testing awal jarak jauh, pakai angka besar agar hasil lama masih bisa dibaca.
# Setelah stabil, ubah ke 300 agar hanya hasil 5 menit terakhir yang diterima.
MEASUREMENT_MAX_AGE_SECONDS=999999999

# Website bisa dibuka dari perangkat lain di jaringan yang sama.
WEB_HOST=0.0.0.0
WEB_PORT=5000
WEB_DEBUG=false

# Penyimpanan: sqlite (default, offline-first) atau memory (test).
# DB_PATH opsional; kosong = config/ukurku.db
STORAGE_MODE=sqlite
DB_PATH=
